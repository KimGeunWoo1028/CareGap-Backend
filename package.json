{
  "name": "caregap-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "firebase-admin": "14.5.0",
    "pg": "8.16.3",
    "sharp": "0.34.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
